# Set to the VM's private LAN IP to accept requests from Canvas server instances.
CAPTURE_BIND_ADDRESS=127.0.0.1
CAPTURE_HOST_PORT=8085
CAPTURE_CONCURRENCY=1
CAPTURE_TIMEOUT_MS=120000
CAPTURE_MAX_BYTES=33554432
# Three IPv4 octets for the dedicated /24 Docker network; avoid existing LAN/VPN routes.
CAPTURE_NETWORK_PREFIX=172.30.86
